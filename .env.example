# Required for plan generation
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Census API (population + housing by ZIP). Get key at api.census.gov (~5 min).
# CENSUS_API_KEY=

# Optional: override API bases
# ZIPPO_API_BASE=https://api.zippopotam.us
# CENSUS_API_BASE=https://api.census.gov
# OVERPASS_API_BASE=https://overpass-api.de/api
# NOAA_API_BASE=https://api.weather.gov

# Optional: LLM model
# OPENAI_MODEL=gpt-4o-mini
